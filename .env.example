# Optional. The setup page (opened automatically by run.bat on first start) creates .env
# and fills in the admin password and Spotify app for you. Everything below is optional;
# copy a line into .env to change it.

# Spotify app (filled in by the setup page).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# Redirect URI registered in the Spotify app. Defaults to http://127.0.0.1:<PORT>/callback.
# SPOTIFY_REDIRECT_URI=

# Admin password (the setup page stores it hashed as ADMIN_PASSWORD_HASH instead).
# ADMIN_PASSWORD=

# Port to serve on. Picked on first start (80 if free, for the shortest link http://jukebox.local/,
# else 8000) and saved in .env. If you change it, add the new redirect URI shown on the setup page
# to your Spotify app.
# PORT=80

# Friendly name advertised on the local network: "jukebox" -> http://jukebox.local
# Empty disables it.
# MDNS_NAME=jukebox

# This computer's LAN IP, if it can't be detected (Docker Desktop).
# HOST_IP=

# The URL guests should use, if not the auto-detected LAN address (DNS name, reverse proxy).
# PUBLIC_URL=

# Open the browser on start (setup page or admin page). 0 to disable.
# OPEN_BROWSER=1

# SQLite database file.
# DATABASE_PATH=jukebox.db

# How often (seconds) to check what's playing.
# POLL_INTERVAL=2
